{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whisper-transcriber",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"]
  },
  "triggers": {
    // 5分ごと: タイムアウト検知 / 毎日 03:00 JST: 期限切れデータの削除
    "crons": ["*/5 * * * *", "0 18 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whisper",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "whisper-files" }],
  "vars": {
    "APP_URL": "https://REPLACE_WITH_APP_HOST",
    "R2_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "R2_BUCKET_NAME": "whisper-files",
    "MODAL_ENDPOINT_URL": "https://REPLACE_WITH_MODAL_ENDPOINT.modal.run",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_AUD"
  }
}
